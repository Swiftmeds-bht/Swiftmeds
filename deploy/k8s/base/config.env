# Settings that are not secret, shared by every pod as the ConfigMap
# "swiftmed-config" (kustomization.yaml). Each Deployment reads only the keys it
# needs. Values match .env.example; secrets are in secrets.env (not committed).

LOG_LEVEL=info

# Every service reaches the others through the in-cluster Traefik (traefik.yaml),
# which routes gRPC by :authority to the right pods, as in Docker Compose.
TRAEFIK_GRPC_TARGET=traefik:50051
ANALYTICS_UPSTREAM=traefik:50051
EXPIRY_HOLDS_UPSTREAM=traefik:50051
FEEDBACK_UPSTREAM=traefik:50051
HOLDS_UPSTREAM=traefik:50051
SEARCH_UPSTREAM=traefik:50051
STOCK_SYNC_UPSTREAM=traefik:50051
SUBSTITUTION_UPSTREAM=traefik:50051
WATCHLIST_UPSTREAM=traefik:50051

# gRPC ports.
AUTH_GRPC_PORT=50051
USER_PROFILE_GRPC_PORT=50052
PHARMACY_REGISTRY_GRPC_PORT=50053
NOTIFICATION_GRPC_PORT=50054
CATALOG_GRPC_PORT=50055
INVENTORY_GRPC_PORT=50056
STOCK_SYNC_GRPC_PORT=50057
SUBSTITUTION_GRPC_PORT=50058
ANALYTICS_GRPC_PORT=50059
SEARCH_GRPC_PORT=50060
RANKING_GRPC_PORT=50061
GEO_GRPC_PORT=50062
PRICING_GRPC_PORT=50063
WATCHLIST_GRPC_PORT=50064
HOLDS_GRPC_PORT=50065
EXPIRY_GRPC_PORT=50066
FEEDBACK_GRPC_PORT=50067
TRUST_GRPC_PORT=50068
FRESHNESS_GRPC_PORT=50069

# Gateway and web apps. CORS lists the addresses the apps are opened at: the
# laptop's k3d ports (deploy/k8s/local) and, once SCRUM-75 sets it up, the
# public URL.
GATEWAY_HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:9000
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
GATEWAY_URL=http://gateway:8080
USE_DEMO_DATA=false

# Auth (the signing key is in secrets.env).
JWT_ISSUER=swiftmed
JWT_TTL=15m
JWT_REFRESH_TTL=720h

# Holds and Expiry. Keep the two hold durations equal.
HOLDS_MAX_ACTIVE_PER_USER=3
HOLDS_HOLD_DURATION=2h
HOLDS_CALL_TIMEOUT=3s
HOLDS_PENDING_TIMEOUT=10m
HOLDS_SWEEP_INTERVAL=1m
EXPIRY_HOLD_DURATION=2h
EXPIRY_HOLDS_CALL_TIMEOUT=2s
EXPIRY_SWEEP_BATCH_SIZE=50

# Search and the services it fans out to.
SEARCH_CALL_TIMEOUT=800ms
SEARCH_REQUEST_TIMEOUT=2s
STOCK_SYNC_CALL_TIMEOUT=800ms
SUBSTITUTION_CALL_TIMEOUT=800ms
WATCHLIST_GEO_TIMEOUT=2s
FEEDBACK_HOLDS_TIMEOUT=2s

# Freshness, Trust and Ranking.
FRESHNESS_HIGH_WITHIN=6h
FRESHNESS_MEDIUM_WITHIN=24h
TRUST_HALF_LIFE=720h
TRUST_PRIOR_WEIGHT=3
RANKING_WEIGHT_DISTANCE=0.40
RANKING_WEIGHT_FRESHNESS=0.25
RANKING_WEIGHT_TRUST=0.20
RANKING_WEIGHT_PRICE=0.15
