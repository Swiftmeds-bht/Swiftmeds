# Copy to .env and change the secrets: cp .env.example .env
# .env is gitignored. Never commit real values.
# Hostnames (postgres, rabbitmq) are Docker Compose service names.

# --- Postgres: one server, one database per service ---
POSTGRES_USER=swiftmed
POSTGRES_PASSWORD=change-me

AUTH_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/auth_db?sslmode=disable
USER_PROFILE_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/user_profile_db?sslmode=disable
PHARMACY_REGISTRY_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/pharmacy_registry_db?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/notification_db?sslmode=disable
CATALOG_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/catalog_db?sslmode=disable
INVENTORY_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/inventory_db?sslmode=disable
STOCK_SYNC_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/stock_sync_db?sslmode=disable
SUBSTITUTION_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/substitution_db?sslmode=disable
ANALYTICS_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/analytics_db?sslmode=disable
GEO_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/geo_db?sslmode=disable
PRICING_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/pricing_db?sslmode=disable
WATCHLIST_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/watchlist_db?sslmode=disable
HOLDS_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/holds_db?sslmode=disable
EXPIRY_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/expiry_db?sslmode=disable
FEEDBACK_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/feedback_db?sslmode=disable
TRUST_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/trust_db?sslmode=disable
FRESHNESS_DATABASE_URL=postgres://swiftmed:change-me@postgres:5432/freshness_db?sslmode=disable
# gateway, search and ranking own no data, so they have no database.

# --- RabbitMQ ---
# The broker user is created from deploy/rabbitmq/definitions.json (swiftmed / change-me).
# To change the password, regenerate its hash there:
#   docker run --rm rabbitmq:3.13-management rabbitmqctl hash_password <new-password>
RABBITMQ_URL=amqp://swiftmed:change-me@rabbitmq:5672/

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=swiftmed
JWT_TTL=15m
JWT_REFRESH_TTL=720h

# --- Ports ---
GATEWAY_HTTP_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081

AUTH_GRPC_PORT=50051
USER_PROFILE_GRPC_PORT=50052
PHARMACY_REGISTRY_GRPC_PORT=50053
NOTIFICATION_GRPC_PORT=50054
CATALOG_GRPC_PORT=50055
INVENTORY_GRPC_PORT=50056
STOCK_SYNC_GRPC_PORT=50057
SUBSTITUTION_GRPC_PORT=50058
ANALYTICS_GRPC_PORT=50059
SEARCH_GRPC_PORT=50060
RANKING_GRPC_PORT=50061
GEO_GRPC_PORT=50062
PRICING_GRPC_PORT=50063
WATCHLIST_GRPC_PORT=50064
HOLDS_GRPC_PORT=50065
EXPIRY_GRPC_PORT=50066
FEEDBACK_GRPC_PORT=50067
TRUST_GRPC_PORT=50068
FRESHNESS_GRPC_PORT=50069
